# このファイルを .env にコピーすれば設定を上書きできる。
# 何も設定しなくても既定値で動く。

# サーバのポート番号（既定 5487。衝突しにくい値を選んである）
PORT=5487

# 待ち受けアドレス。127.0.0.1 のまま変えないこと（変えると同じ LAN の他人から見える）
HOST=127.0.0.1

# MP3 の保存先。空なら ~/Music/MP3コンバーター
OUTPUT_DIR=

# アップロードできるファイルの上限バイト数（既定 2GB）
MAX_UPLOAD_BYTES=2147483648

# 同時に変換する本数（既定 2。増やすと PC が重くなる）
MAX_CONCURRENT_JOBS=2

# 作業用の一時ファイルを何時間で消すか（既定 24）
RETENTION_HOURS=24

# yt-dlp の自動更新間隔（時間）。0 で無効
YTDLP_UPDATE_INTERVAL_HOURS=24

# 実行ファイルの場所を手動で指定したい場合のみ設定（通常は自動検出）
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_PATH=
